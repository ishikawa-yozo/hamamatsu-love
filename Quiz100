   explanation:"浜松城公園では毎年春に桜まつりが開催され、桜の名所として多くの市民が花見を楽しみます。"},

  {q:"浜松市の天竜川下りで有名な観光スポットはどこですか？",
   choices:["龍山渓谷","かわね路","船明ダム湖"],answer:0,
   explanation:"天竜川の龍山渓谷周辺では天竜川下りが楽しめる観光スポットとして知られています。"},

  {q:"浜松市が推進する「音楽のまちづくり」政策の象徴的な施設はどれですか？",
   choices:["アクトシティ浜松","浜松アリーナ","グランシップ"],answer:0,
   explanation:"アクトシティ浜松は音楽ホールや展示施設を備えた複合文化施設で、浜松の音楽文化発信の拠点です。"},

  {q:"浜松市にゆかりのある徳川四天王の一人で「井伊の赤備え」で知られる武将は誰ですか？",
   choices:["酒井忠次","本多忠勝","井伊直政"],answer:2,
   explanation:"井伊直政は浜松市（旧・引佐郡井伊谷）出身の武将で、徳川四天王の一人として「井伊の赤備え」で恐れられました。"}
];

// ===================================
// クイズ動作ロジック
// ===================================

let currentQuestions = [];  // 出題する10問
let currentIndex = 0;       // 現在の問題番号
let score = 0;              // 正解数
let userAnswers = [];       // ユーザーの回答記録

// ── ランダムに10問選ぶ ──
function getRandomQuestions(num) {
    const shuffled = [...allQuestions].sort(() => Math.random() - 0.5);
    return shuffled.slice(0, num);
}

// ── クイズ開始 ──
function startQuiz() {
    currentQuestions = getRandomQuestions(10);
    currentIndex = 0;
    score = 0;
    userAnswers = [];

    document.getElementById('start-screen').style.display = 'none';
    document.getElementById('result-screen').style.display = 'none';
    document.getElementById('quiz-screen').style.display = 'block';

    showQuestion();
}

// ── 問題を表示 ──
function showQuestion() {
    const q = currentQuestions[currentIndex];

    // 進捗バー更新
    const progress = (currentIndex / 10) * 100;
    document.getElementById('progress-fill').style.width = progress + '%';

    // 問題番号・スコア更新
    document.getElementById('question-num').textContent =
        '第 ' + (currentIndex + 1) + ' 問 / 全 10 問';
    document.getElementById('score-display').textContent =
        '正解: ' + score + '問';

    // 問題文
    document.getElementById('question-text').textContent = q.q;

    // 選択肢を生成
    const choicesEl = document.getElementById('choices');
    choicesEl.innerHTML = '';
    const labels = ['A', 'B', 'C'];
    q.choices.forEach(function(choice, index) {
        const btn = document.createElement('button');
        btn.className = 'choice-btn';
        btn.innerHTML =
            '<span class="choice-label">' + labels[index] + '</span>' + choice;
        btn.onclick = function() { selectAnswer(index); };
        choicesEl.appendChild(btn);
    });

    // 解説・結果アイコン・次へボタンをリセット
    const expBox = document.getElementById('explanation-box');
    expBox.classList.remove('show');
    document.getElementById('explanation-text').textContent = '';

    const resultIcon = document.getElementById('result-icon');
    resultIcon.classList.remove('show');
    resultIcon.textContent = '';

    const btnNext = document.getElementById('btn-next');
    btnNext.classList.remove('show');

    // 最終問題は「次へ」→「結果を見る」に変更
    if (currentIndex === 9) {
        btnNext.textContent = '結果を見る 🏁';
    } else {
        btnNext.textContent = '次の問題へ →';
    }
}

// ── 回答選択 ──
function selectAnswer(selectedIndex) {
    const q = currentQuestions[currentIndex];
    const buttons = document.querySelectorAll('.choice-btn');

    // ボタンを全て無効化
    buttons.forEach(function(btn) {
        btn.disabled = true;
    });

    const isCorrect = (selectedIndex === q.answer);

    // 選んだボタンに正解・不正解のスタイル
    if (isCorrect) {
        buttons[selectedIndex].classList.add('correct');
    } else {
        buttons[selectedIndex].classList.add('wrong');
        // 正解のボタンも表示
        buttons[q.answer].classList.add('show-answer');
    }

    // 結果アイコン表示
    const resultIcon = document.getElementById('result-icon');
    resultIcon.classList.add('show');
    if (isCorrect) {
        resultIcon.textContent = '⭕ 正解！';
        resultIcon.style.color = '#28a745';
        score++;
    } else {
        resultIcon.textContent = '❌ 不正解…';
        resultIcon.style.color = '#dc3545';
    }

    // 解説表示
    document.getElementById('explanation-text').textContent = q.explanation;
    document.getElementById('explanation-box').classList.add('show');

    // 回答を記録
    userAnswers.push({
        question: q.q,
        selected: selectedIndex,
        correct: q.answer,
        isCorrect: isCorrect,
        correctText: q.choices[q.answer]
    });

    // 次へボタン表示
    document.getElementById('btn-next').classList.add('show');

    // スコア更新
    document.getElementById('score-display').textContent =
        '正解: ' + score + '問';
}

// ── 次の問題へ ──
function nextQuestion() {
    currentIndex++;
    if (currentIndex >= 10) {
        showResult();
    } else {
        showQuestion();
    }
}

// ── 結果画面を表示 ──
function showResult() {
    document.getElementById('quiz-screen').style.display = 'none';
    document.getElementById('result-screen').style.display = 'block';

    const isPassed = score >= 8;
    const today = new Date();
    const dateStr = today.getFullYear() + '年' +
        (today.getMonth() + 1) + '月' +
        today.getDate() + '日';

    // 答え一覧を生成
    let reviewHTML = '<div class="answer-review"><h3>📋 回答一覧</h3>';
    userAnswers.forEach(function(ans, i) {
        const markClass = ans.isCorrect ? 'correct' : 'wrong';
        const markText  = ans.isCorrect ? '○' : '×';
        reviewHTML += '<div class="answer-item">';
        reviewHTML += '<div class="answer-mark ' + markClass + '">' + markText + '</div>';
        reviewHTML += '<div class="answer-text">';
        reviewHTML += '<div>Q' + (i + 1) + '. ' + ans.question + '</div>';
        if (!ans.isCorrect) {
            reviewHTML += '<div class="answer-correct-text">✅ 正解: ' + ans.correctText + '</div>';
        }
        reviewHTML += '</div></div>';
    });
    reviewHTML += '</div>';

    // 合格・不合格で表示内容を切り替え
    let resultHTML = '';

    if (isPassed) {
        resultHTML = `
        <div class="fade-in">
            <div style="font-size:24px;font-weight:bold;color:#333;margin-bottom:10px;">
                🎉 合格おめでとうございます！
            </div>
            <div class="score-circle pass">
                <div class="score-number">${score}<span style="font-size:24px;">/10</span></div>
                <div class="score-label">正解</div>
            </div>
            <div class="certificate">
                <div class="certificate-title">認　定　証</div>
                <div class="certificate-seal">🏯</div>
                <div class="certificate-main">
                    あなたを<br>
                    浜松愛♡ある<br>
                    名誉市民として認めます
                </div>
                <div style="font-size:13px;color:#666;margin-top:10px;">
                    正解数: ${score} / 10問（正解率 ${score * 10}%）
                </div>
                <div class="certificate-date">認定日: ${dateStr}</div>
                <div style="margin-top:10px;font-size:20px;">🎏🎸🎺</div>
            </div>
            ${reviewHTML}
            <div class="btn-group">
                <button class="btn-retry" onclick="startQuiz()">🔄 もう一度挑戦</button>
                <button class="btn-retry" style="background:linear-gradient(135deg,#333,#555);"
                    onclick="backToTop()">🏠 トップへ戻る</button>
            </div>
        </div>`;
    } else {
        resultHTML = `
        <div class="fade-in">
            <div style="font-size:24px;font-weight:bold;color:#333;margin-bottom:10px;">
                結果発表
            </div>
            <div class="score-circle fail">
                <div class="score-number">${score}<span style="font-size:24px;">/10</span></div>
                <div class="score-label">正解</div>
            </div>
            <div class="fail-message">
                <div style="font-size:18px;font-weight:bold;color:#e83e3e;margin-bottom:10px;">
                    😢 残念！不合格です
                </div>
                <div>合格ライン: <strong>8問以上</strong></div>
                <div>あなたの正解数: <strong>${score}問 / 10問</strong></div>
                <div>正解率: <strong>${score * 10}%</strong></div>
                <div style="margin-top:10px;">
                    もう一度挑戦して、浜松愛♡名誉市民を目指しましょう！
                </div>
            </div>
            ${reviewHTML}
            <div class="btn-group">
                <button class="btn-retry" onclick="startQuiz()">🔄 もう一度挑戦</button>
                <button class="btn-retry" style="background:linear-gradient(135deg,#333,#555);"
                    onclick="backToTop()">🏠 トップへ戻る</button>
            </div>
        </div>`;
    }

    document.getElementById('result-content').innerHTML = resultHTML;

    // 画面トップへスクロール
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── トップへ戻る ──
function backToTop() {
    document.getElementById('result-screen').style.display = 'none';
    document.getElementById('quiz-screen').style.display = 'none';
    document.getElementById('start-screen').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>
</body>
</html>
